{
  "name": "@zeos/git-mcp",
  "version": "0.1.0",
  "description": "MCP server for zeos git operations with offline queue",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "zeos-git-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@zeos/mcp-shared": "workspace:*",
    "simple-git": "^3.22.0"
  },
  "devDependencies": {}
}

{
  "name": "@zeos/zeos-mcp",
  "version": "0.1.0",
  "description": "Unified MCP server for zeos - local-first operation with async GitHub sync",
  "author": "my-org <support@my-org.com>",
  "license": "MIT",
  "homepage": "https://github.com/rgsuarez/zeos/tree/main/infrastructure/mcp-servers/packages/zeos-mcp",
  "repository": {
    "type": "git",
    "url": "https://github.com/rgsuarez/zeos.git",
    "directory": "infrastructure/mcp-servers/packages/zeos-mcp"
  },
  "bugs": {
    "url": "https://github.com/rgsuarez/zeos/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "zeos",
    "claude",
    "ai",
    "offline-first"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "bin": {
    "zeos-mcp": "dist/index.js",
    "zeos-configure": "dist/cli/configure.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/cli/configure.ts --format esm --dts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "dev": "tsx watch src/index.ts",
    "benchmark": "tsx ../../scripts/benchmark.ts",
    "prepublishOnly": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.6.0",
    "@zeos/filesystem-mcp": "workspace:*",
    "@zeos/git-mcp": "workspace:*",
    "@zeos/mcp-shared": "workspace:*",
    "@zeos/shell-mcp": "workspace:*",
    "@zeos/sqlite-mcp": "workspace:*",
    "better-sqlite3": "^11.1.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}